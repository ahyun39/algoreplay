# Copy to .env (loaded automatically) or export these variables.

# --- Your problem repository (can also be entered in the sidebar) ---
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=
# Only needed for private repositories (fine-grained token, Contents: Read-only)
GITHUB_TOKEN=
GITHUB_API_VERSION=2026-03-10

# --- Optional: LLM features (report, hints, test-input generation) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# --- Storage & sandbox ---
DATABASE_PATH=./algoreplay.db
DOCKER_IMAGE=python:3.11-slim
SQL_DOCKER_IMAGE=postgres:16-alpine
EXEC_TIMEOUT_SEC=3
EXEC_MEMORY_MB=256
EXEC_CPU=1
